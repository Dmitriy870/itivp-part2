{
  "info": {
    "name": "Secure Training Platform API",
    "description": "Позитивные и негативные сценарии безопасного REST API платформы переподготовки.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "studentEmail", "value": "" },
    { "key": "userToken", "value": "" },
    { "key": "moderatorToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Health and headers",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('200 OK', () => pm.response.to.have.status(200));",
        "pm.test('X-Frame-Options DENY', () => pm.expect(pm.response.headers.get('X-Frame-Options')).to.eql('DENY'));"
      ] } }]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"Strong123!\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "pm.collectionVariables.set('studentEmail', `student.${Date.now()}@example.com`);"
            ] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('userId', pm.response.json().data.id);"
            ] } }
          ]
        },
        {
          "name": "Register invalid email and weak password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-email\",\n  \"password\": \"short\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 validation error', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Mass assignment attack",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"attacker@example.com\",\n  \"password\": \"Strong123!\",\n  \"role\": \"admin\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400 unknown role field', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Login user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"Strong123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 with token', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) pm.collectionVariables.set('userToken', pm.response.json().data.accessToken);"
          ] } }]
        },
        {
          "name": "Current user with JWT",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 authenticated', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Current user without JWT",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401 unauthenticated', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Rotate refresh token",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 refreshed', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Courses and roles",
      "item": [
        {
          "name": "List public courses",
          "request": { "method": "GET", "url": "{{baseUrl}}/courses?page=1&limit=20&published=true" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 public list', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "User forbidden to create course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Безопасная разработка REST API\",\n  \"description\": \"Программа профессиональной переподготовки по безопасности серверных приложений.\",\n  \"category\": \"Информационные технологии\",\n  \"format\": \"online\",\n  \"durationHours\": 420,\n  \"price\": 1750,\n  \"certificateIssued\": true,\n  \"webinarUrl\": \"https://webinars.example.com/secure-api\",\n  \"published\": true\n}" },
            "url": "{{baseUrl}}/courses"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 role guard', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Login moderator",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"moderator@example.com\",\n  \"password\": \"Moderator123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('moderatorToken', pm.response.json().data.accessToken);"] } }]
        },
        {
          "name": "Moderator creates course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{moderatorToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Безопасная разработка REST API\",\n  \"description\": \"Программа профессиональной переподготовки по безопасности серверных приложений.\",\n  \"category\": \"Информационные технологии\",\n  \"format\": \"online\",\n  \"durationHours\": 420,\n  \"price\": 1750,\n  \"certificateIssued\": true,\n  \"webinarUrl\": \"https://webinars.example.com/secure-api\",\n  \"published\": true\n}" },
            "url": "{{baseUrl}}/courses"
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 created', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) pm.collectionVariables.set('courseId', pm.response.json().data.id);"
          ] } }]
        },
        {
          "name": "Get course by UUID",
          "request": { "method": "GET", "url": "{{baseUrl}}/courses/{{courseId}}" }
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin123!\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) pm.collectionVariables.set('adminToken', pm.response.json().data.accessToken);"] } }]
        },
        {
          "name": "Admin deletes course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/courses/{{courseId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('204 deleted', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    },
    {
      "name": "Admin users audit",
      "item": [
        {
          "name": "List users as admin",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "User forbidden from users list",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/users"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 forbidden', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    }
  ]
}
