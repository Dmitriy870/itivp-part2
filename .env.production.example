# Copy this file to .env.production only on the server. Never commit real values.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
DEBUG_ENDPOINT_TOKEN=replace-with-a-long-random-debug-token

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ReplaceWithStrongAdminPassword1!
MODERATOR_EMAIL=moderator@example.com
MODERATOR_PASSWORD=ReplaceWithStrongModeratorPassword1!

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://207.180.199.246:8080
GLOBAL_RATE_LIMIT=300
AUTH_RATE_LIMIT=30
WRITE_RATE_LIMIT=60
LOG_LEVEL=info
APP_RELEASE=ipr22
ENABLE_TEST_ENDPOINTS=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-password
GRAFANA_ROOT_URL=http://207.180.199.246:3002
DOCKER_GID=112

# Optional until external accounts are connected.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
TELEGRAM_BOT_TOKEN=0000000000:placeholder
TELEGRAM_CHAT_ID=0
